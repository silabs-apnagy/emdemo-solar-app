---
workspace_name: "MatterSolarPanelSolution"
label: "lighting-app-series-2"
quality: "production"
package: "matter"
description: "Solution containing both a bootloader and a Matter over Thread Lighting\
  \ App Example"
project:
- id: "application"
  path: "MatterSolarPanelOverThread/MatterSolarPanelOverThread.slcp"
  output: "MatterSolarPanelOverThread"
- id: "bootloader"
  path: "Matter-Bootloader_2/Matter-Bootloader_2.slcp"
  output: "Matter-Bootloader_2"
post_build:
  profile: ""
  path: "MatterSolarPanelSolution.slpb"
